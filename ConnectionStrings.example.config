<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
  <!-- The first build copies this file to ConnectionStrings.config, which is not uploaded to GitHub.
       Edit ConnectionStrings.config if your SQL Server has a different name. -->
  <add name="CampusEventDb" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=CampusEventDb;Integrated Security=True" providerName="System.Data.SqlClient" />
</connectionStrings>
