<?xml version="1.0" encoding="utf-8"?>
<!-- To send real email, copy this file to Email.config and fill in the blank values.
     Email.config is not uploaded to GitHub. Restart the site after changing it.
     For Gmail, turn on 2-Step Verification and use an App Password, not your normal password.
     Without this setup, registration still works and the notification is recorded as Failed. -->
<appSettings>
  <add key="SmtpHost" value="smtp.gmail.com" />
  <add key="SmtpPort" value="587" />
  <add key="SmtpEnableSsl" value="true" />
  <add key="SmtpUser" value="" />
  <add key="SmtpPassword" value="" />
  <add key="SmtpFrom" value="" />
</appSettings>
